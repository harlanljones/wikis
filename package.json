{
  "name": "wikis",
  "description": "A collection of plain-language wikis, each a small Bun web app that serves markdown files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlanljones/wikis.git"
  },
  "homepage": "https://github.com/harlanljones/wikis#readme",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "start": "bun run --filter './apps/*' start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "new-wiki": "bun run scripts/new-wiki.ts",
    "cards": "bun run scripts/cards.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
