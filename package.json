{
  "name": "wikis",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "start": "bun run --filter './apps/*' start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "new-wiki": "bun run scripts/new-wiki.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
